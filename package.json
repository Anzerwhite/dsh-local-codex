{
  "name": "dsh-local-codex",
  "version": "0.1.0",
  "description": "Codex Mode for DeepSeek Harness: hand one session to your local Codex CLI and show its replies, commands and file changes inline. / 把单个 DSH 会话交给本机 Codex 并同步显示其回复与工具动作。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "codex-cli",
    "agent",
    "session",
    "sync",
    "local"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anzerwhite/dsh-local-codex.git"
  },
  "homepage": "https://github.com/Anzerwhite/dsh-local-codex#readme",
  "bugs": {
    "url": "https://github.com/Anzerwhite/dsh-local-codex/issues"
  }
}
